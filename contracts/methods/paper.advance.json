{
  "method": "paper.advance",
  "summary": "推进模拟账户至下一交易日",
  "owner": "P-05",
  "phase": "mvp0",
  "timeoutMs": 30000,
  "params": {
    "type": "object",
    "required": [
      "accountId"
    ],
    "properties": {
      "accountId": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "required": [
      "clockDate",
      "tradingDay",
      "filled",
      "rejected",
      "pendingRemaining",
      "portfolio"
    ],
    "properties": {
      "clockDate": {
        "$ref": "types.schema.json#/$defs/IsoDate"
      },
      "tradingDay": {
        "type": "boolean",
        "const": true
      },
      "filled": {
        "type": "array",
        "items": {
          "$ref": "types.schema.json#/$defs/PaperOrder"
        }
      },
      "rejected": {
        "type": "array",
        "items": {
          "$ref": "types.schema.json#/$defs/PaperOrder"
        }
      },
      "pendingRemaining": {
        "type": "integer",
        "minimum": 0
      },
      "portfolio": {
        "$ref": "types.schema.json#/$defs/Portfolio"
      }
    },
    "additionalProperties": false
  },
  "errors": [
    "NOT_FOUND",
    "DATA_INSUFFICIENT"
  ],
