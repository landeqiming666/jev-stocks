{
  "method": "secrets.set",
  "summary": "保存 Jev 密钥",
  "owner": "C-04",
  "phase": "mvp0",
  "timeoutMs": 30000,
  "params": {
    "type": "object",
    "required": [
      "name",
      "value"
    ],
    "properties": {
      "name": {
        "type": "string",
        "enum": [
          "jevKey"
        ]
      },
      "value": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^\\S+$"
      }
    },
    "additionalProperties": false
  },
  "result": {
    "type": "object",
    "required": [
      "ok"
    ],
    "properties": {
      "ok": {
        "type": "boolean",
        "const": true
      }
    },
    "additionalProperties": false
  },
  "errors": [
    "INVALID_ARGUMENT"
  ],
  "examples": [
    {
      "name": "ok",
      "params": {
        "name": "jevKey",
        "value": "<secret>"
      },
      "result": {
        "ok": true
      }
    }
  ]
}
