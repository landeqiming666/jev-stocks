{
  "method": "paper.createAccount",
  "summary": "创建模拟账户",
  "owner": "P-05",
  "phase": "mvp0",
  "timeoutMs": 30000,
  "params": {
    "type": "object",
    "required": [
      "name",
      "initialCash",
      "startDate"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 30,
        "pattern": "\\S"
      },
      "initialCash": {
        "type": "string",
        "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,4})?(?![\\s\\S])"
      },
      "startDate": {
        "$ref": "types.schema.json#/$defs/IsoDate"
      }
    },
    "additionalProperties": false
  },
  "result": {
    "$ref": "types.schema.json#/$defs/PaperAccount"
  },
  "errors": [
    "INVALID_ARGUMENT",
    "CONFLICT"
  ],
  "examples": [
    {
      "name": "ok",
      "params": {
        "name": "回放账户 A",
        "initialCash": "100000.00",
        "startDate": "2026-09-01"
      },
      "result": {
        "accountId": "01JC8Z5V3Q000000000000J9Y1",
        "name": "回放账户 A",
        "baseCurrency": "USD",
        "initialCash": "100000.0000",
        "startDate": "2026-09-01",
        "clockDate": "2026-10-14",
        "createdAt": "2026-10-30T02:00:00Z"
      }
    }
  ]
}
