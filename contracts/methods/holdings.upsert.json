      "params": {
        "instrumentId": "us:ZZAR",
        "quantity": "-5"
      },
      "error": {
        "code": "INVALID_ARGUMENT",
        "message": "数量不能为负数",
        "data": {
          "retryable": false,
          "field": "quantity"
        }
      }
